# Claude API key (get one at https://platform.claude.com)
ANTHROPIC_API_KEY=

# Voyage AI API key for embeddings: a Voyage key (pa-...) or a MongoDB Atlas key (al-...)
VOYAGE_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email
SEC_RAG_EDGAR_USER_AGENT="sec-filings-analyst-rag your-email@example.com"

# Optional overrides (defaults live in src/sec_rag/config.py)
# SEC_RAG_DATA_DIR=data
# SEC_RAG_EMBEDDING_MODEL=voyage-finance-2   # changing it needs a full `sec-rag index`
# SEC_RAG_EMBEDDING_BATCH_SIZE=128   # without a card on file Voyage allows ~10K tokens/min: use 16
SEC_RAG_LLM_MODEL=claude-opus-5-5
SEC_RAG_LLM_EFFORT=medium       # low | medium | high | xhigh | max
# SEC_RAG_REWRITE_EFFORT=low
# SEC_RAG_TOP_K=8
# SEC_RAG_RETRIEVAL_MODE=hybrid   # hybrid | dense | keyword
# SEC_RAG_RERANK=false             # hybrid only: Claude rescores the top fused chunks
# SEC_RAG_RERANK_MODEL=claude-haiku-5-5
# SEC_RAG_RERANK_EFFORT=low
# SEC_RAG_RERANK_CANDIDATES=20
# SEC_RAG_CHAT_HISTORY_TURNS=3
SEC_RAG_JUDGE_MODEL=claude-sonnet-5-5   # LLM judge for the DeepEval retrieval eval
SEC_RAG_JUDGE_EFFORT=medium
